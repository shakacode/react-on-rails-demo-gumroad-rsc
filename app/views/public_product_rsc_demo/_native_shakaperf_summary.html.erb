<% compact = local_assigns.fetch(:compact, false) %>
<% headline_metrics = @presenter.native_shakaperf_headline_metrics %>
<% result_cards = @presenter.native_shakaperf_result_cards %>

<section class="dd-native-proof<%= " dd-native-proof--compact" if compact %>" aria-labelledby="latest-shakaperf-title">
  <header class="dd-native-proof__header">
    <div>
      <p class="dd-eyebrow">Latest measured result · August 12, 2026</p>
      <h2 id="latest-shakaperf-title">Paint is faster. Payload is heavier.</h2>
    </div>
    <span class="dd-status-chip dd-status-chip--mixed"><%= native_shakaperf[:exit_summary] %> · exit <%= native_shakaperf[:exit_status] %></span>
  </header>

  <div class="dd-signal-grid" aria-label="Latest ShakaPerf headline metrics">
    <% headline_metrics.each do |metric| %>
      <article class="dd-signal-card dd-signal-card--<%= metric[:tone] %>">
        <p><%= metric[:label] %></p>
        <strong><%= metric[:change] %></strong>
        <% metric[:values].each do |value| %>
          <span><%= value %></span>
        <% end %>
      </article>
    <% end %>
  </div>

  <div class="dd-proof-grid">
    <section class="dd-score-panel" aria-labelledby="lighthouse-score-title">
      <header>
        <p class="dd-eyebrow">Lighthouse performance</p>
        <h3 id="lighthouse-score-title">Both products score higher</h3>
      </header>
      <% @presenter.native_shakaperf_scorecards.each do |scorecard| %>
        <div class="dd-score-row">
          <strong><%= scorecard[:label] %></strong>
          <div class="dd-score-track" aria-label="<%= scorecard[:label] %> control score <%= scorecard[:control_score] %> out of 100">
            <span class="dd-score-bar dd-score-bar--control" style="--score: <%= scorecard[:control_score] %>%"></span>
            <small>Control <%= scorecard[:control_score] %></small>
          </div>
          <div class="dd-score-track" aria-label="<%= scorecard[:label] %> RSC score <%= scorecard[:experiment_score] %> out of 100">
            <span class="dd-score-bar dd-score-bar--rsc" style="--score: <%= scorecard[:experiment_score] %>%"></span>
            <small>RSC <%= scorecard[:experiment_score] %></small>
          </div>
        </div>
      <% end %>
    </section>

    <section class="dd-cause-panel" aria-labelledby="why-faster-title">
      <header>
        <p class="dd-eyebrow">Why paint moved forward</p>
        <h3 id="why-faster-title">Rendered DOM → fewer requests → earlier paint</h3>
      </header>
      <ol class="dd-cause-flow">
        <% @presenter.native_shakaperf_explanation_steps.each do |step| %>
          <li>
            <span><%= step[:number] %></span>
            <strong><%= step[:title] %></strong>
            <p><%= step[:detail] %></p>
          </li>
        <% end %>
      </ol>
    </section>
  </div>

  <% unless compact %>
    <div class="dd-product-results" id="tested-pages">
      <% result_cards.each do |result| %>
        <article class="dd-result-card">
          <header>
            <div>
              <p class="dd-eyebrow">10 control + 10 RSC runs</p>
              <h3><%= result[:label] %></h3>
            </div>
            <div class="dd-result-links">
              <a href="<%= result[:control_url] %>">Control</a>
              <a href="<%= result[:experiment_url] %>">RSC</a>
            </div>
          </header>

          <div class="dd-result-columns">
            <section aria-label="Measured improvements">
              <h4>Improved</h4>
              <% result[:wins].each do |metric| %>
                <div class="dd-metric-line dd-metric-line--win">
                  <span><%= metric[:label] %></span>
                  <strong><%= metric[:change] %></strong>
                  <small><%= metric[:control] %> → <%= metric[:experiment] %> · p=<%= metric[:p_value] %></small>
                </div>
              <% end %>
            </section>
            <section aria-label="Measured costs">
              <h4>Regressed / flat</h4>
              <% result[:costs].each do |metric| %>
                <% tone = metric[:change] == "no difference" ? "flat" : "cost" %>
                <div class="dd-metric-line dd-metric-line--<%= tone %>">
                  <span><%= metric[:label] %></span>
                  <strong><%= metric[:change] %></strong>
                  <small><%= metric[:control] %> → <%= metric[:experiment] %> · p=<%= metric[:p_value] %></small>
                </div>
              <% end %>
            </section>
          </div>

          <details class="dd-result-quality">
            <summary>Visual and accessibility checks</summary>
            <p><%= result[:quality] %></p>
          </details>
        </article>
      <% end %>
    </div>

    <details class="dd-link-panel dd-proof-trail">
      <summary>Method, revisions, raw files, and historical declaration</summary>
      <div class="dd-detail-grid">
        <p><strong>Runner:</strong> <%= native_shakaperf[:runner] %> · <%= native_shakaperf[:browser] %></p>
        <p><strong>Method:</strong> <%= native_shakaperf[:method] %></p>
        <p><strong>Command:</strong> <code><%= native_shakaperf[:command] %></code></p>
        <p><strong>Revisions:</strong> control <code><%= native_shakaperf[:control_revision] %></code> · RSC <code><%= native_shakaperf[:experiment_revision] %></code></p>
        <p><strong>Ports:</strong> host <code>3100</code> / <code>3200</code>; <code>3000</code> is container-only.</p>
        <p><strong>Audit:</strong> <a href="<%= @presenter.native_shakaperf_artifact_url %>" target="_blank" rel="noopener">committed summary + raw JSON</a> · <a href="<%= PublicProductRscDemoPresenter::HISTORICAL_PERFORMANCE_PR_URL %>" target="_blank" rel="noopener">historical PR 69</a></p>
        <p><strong>Why a response says <code>shakaperf</code>:</strong> it is a disposable Docker runtime label, not a Git revision or proof of the runner.</p>
      </div>
    </details>
  <% end %>

  <footer class="dd-native-verdict">
    <div>
      <strong>Pilot signal, not an overall victory.</strong>
      <span>FCP, LCP, CLS, score, and request count improve. TTFB and bytes regress; Microsoft TBT regresses.</span>
    </div>
    <small>Attribution is architectural: RSC, server rendering, isolated bundles, and legacy-script omission changed together.</small>
  </footer>
</section>
