<% content_for :script do %>
  <script nonce="<%= content_security_policy_nonce %>">
    (() => {
      const root = document.querySelector("[data-rsc-performance-lab]");
      if (!root) return;

      const pairElements = Array.from(root.querySelectorAll("[data-route-pair]"));
      const runButtons = Array.from(root.querySelectorAll("[data-rerun-race]"));
      const runStatus = root.querySelector("[data-run-status]");

      const numberFormatter = new Intl.NumberFormat(undefined, { maximumFractionDigits: 0 });

      const formatMs = (value) => {
        if (!Number.isFinite(value)) return "n/a";
        return `${numberFormatter.format(value)} ms`;
      };

      const formatBytes = (value) => {
        if (!Number.isFinite(value)) return "n/a";
        if (value >= 1024 * 1024) return `${(value / 1024 / 1024).toFixed(2)} MB`;
        if (value >= 1024) return `${(value / 1024).toFixed(1)} KB`;
        return `${numberFormatter.format(value)} B`;
      };

      const setText = (scope, selector, value) => {
        const element = scope.querySelector(selector);
        if (element) element.textContent = value;
      };

      const setMetric = (scope, variant, metric, value) => {
        setText(scope, `[data-metric="${variant}.${metric}"]`, value);
      };

      const setCardState = (scope, variant, state) => {
        const card = scope.querySelector(`[data-route-card="${variant}"]`);
        if (card) card.setAttribute("data-state", state);
      };

      const urlWithCacheBust = (path) => {
        const url = new URL(path, window.location.href);
        url.searchParams.set("perf_lab_run", `${Date.now()}-${Math.random().toString(16).slice(2)}`);
        return url.toString();
      };

      const htmlDecode = (value) => {
        const textarea = document.createElement("textarea");
        textarea.innerHTML = value;
        return textarea.value;
      };

      const encodedByteLength = (value) => new TextEncoder().encode(value).byteLength;

      const inertiaPayloadBytes = (html) => {
        const match = html.match(/data-page="([^"]*)"/);
        if (!match) return 0;
        return encodedByteLength(htmlDecode(match[1]));
      };

      const routeScriptSources = (html) => {
        const documentFragment = new DOMParser().parseFromString(html, "text/html");
        return Array.from(documentFragment.querySelectorAll("script[src]"), (script) =>
          new URL(script.getAttribute("src"), window.location.href).toString(),
        );
      };

      const routeScriptBytes = async (sources) => {
        const results = await Promise.all(
          sources.map(async (source) => {
            try {
              const sourceUrl = new URL(source, window.location.href);
              const response = await fetch(sourceUrl.toString(), { cache: "force-cache", credentials: "omit" });
              if (!response.ok) return { bytes: 0, readable: false };

              return { bytes: (await response.arrayBuffer()).byteLength, readable: true };
            } catch {
              return { bytes: 0, readable: false };
            }
          }),
        );

        return {
          bytes: results.reduce((total, result) => total + result.bytes, 0),
          readableCount: results.filter((result) => result.readable).length,
          unreadableCount: results.filter((result) => !result.readable).length,
        };
      };

      const formatScriptMetric = ({ bytes, readableCount, unreadableCount }, totalCount) => {
        const readableCopy = `${formatBytes(bytes)} across ${readableCount}/${totalCount} readable scripts`;
        return unreadableCount > 0 ? `${readableCopy}; ${unreadableCount} unavailable` : readableCopy;
      };

      const resetMetrics = (scope, variant) => {
        setCardState(scope, variant, "loading");
        setMetric(scope, variant, "status", "Loading...");
        setMetric(scope, variant, "firstChunk", "...");
        setMetric(scope, variant, "complete", "...");
        setMetric(scope, variant, "bytes", "...");
        setMetric(scope, variant, "scripts", "...");
        setMetric(scope, variant, "payload", "...");
        setMetric(scope, variant, "serverTiming", "Waiting for headers");
      };

      const measureRoute = async (scope, variant, path) => {
        resetMetrics(scope, variant);

        const startedAt = performance.now();
        const response = await fetch(urlWithCacheBust(path), {
          cache: "no-store",
          credentials: "omit",
          headers: {
            Accept: "text/html",
            "X-Gumroad-Rsc-Performance-Lab": "1",
          },
        });
        const headersAt = performance.now();
        const serverTiming = response.headers.get("Server-Timing") || "No Server-Timing header exposed";

        if (!response.ok) {
          throw new Error(`${response.status} ${response.statusText || "response error"}`);
        }

        let firstChunkAt = null;
        let bytes = 0;
        let html = "";

        if (response.body?.getReader) {
          const reader = response.body.getReader();
          const decoder = new TextDecoder();

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            if (firstChunkAt == null) firstChunkAt = performance.now();
            bytes += value.byteLength;
            html += decoder.decode(value, { stream: true });
            setMetric(scope, variant, "bytes", formatBytes(bytes));
          }

          html += decoder.decode();
        } else {
          html = await response.text();
          bytes = encodedByteLength(html);
          firstChunkAt = headersAt;
        }

        const completedAt = performance.now();
        const payloadBytes = inertiaPayloadBytes(html);
        const scriptSources = routeScriptSources(html);
        const result = {
          bytes,
          firstChunkMs: (firstChunkAt || headersAt) - startedAt,
          headersMs: headersAt - startedAt,
          inertiaPayloadBytes: payloadBytes,
          scriptBytes: 0,
          scriptCount: scriptSources.length,
          scriptReadableCount: 0,
          scriptSources,
          scriptUnreadableCount: scriptSources.length,
          serverTiming,
          totalMs: completedAt - startedAt,
        };

        setMetric(scope, variant, "status", "HTML complete");
        setMetric(scope, variant, "firstChunk", formatMs(result.firstChunkMs));
        setMetric(scope, variant, "complete", formatMs(result.totalMs));
        setMetric(scope, variant, "bytes", formatBytes(result.bytes));
        setMetric(scope, variant, "scripts", "Waiting for route script pass");
        setMetric(scope, variant, "payload", payloadBytes > 0 ? formatBytes(payloadBytes) : "None");
        setMetric(scope, variant, "serverTiming", serverTiming);

        return result;
      };

      const measureRouteScripts = async (scope, variant, result) => {
        setMetric(scope, variant, "status", "Measuring scripts...");
        const scriptMetric = await routeScriptBytes(result.scriptSources);
        result.scriptBytes = scriptMetric.bytes;
        result.scriptReadableCount = scriptMetric.readableCount;
        result.scriptUnreadableCount = scriptMetric.unreadableCount;
        setMetric(scope, variant, "scripts", formatScriptMetric(scriptMetric, result.scriptCount));
        setMetric(scope, variant, "status", "Complete");
        setCardState(scope, variant, "complete");
        return result;
      };

      const describeResults = (label, inertia, rsc) => {
        const completionDelta = inertia.totalMs - rsc.totalMs;
        const firstChunkDelta = inertia.firstChunkMs - rsc.firstChunkMs;
        const byteDelta = inertia.bytes - rsc.bytes;
        const scriptDelta = inertia.scriptBytes - rsc.scriptBytes;
        const payloadCopy =
          inertia.inertiaPayloadBytes > 0
            ? ` The Inertia document included ${formatBytes(inertia.inertiaPayloadBytes)} of serialized page props; the RSC document did not expose a data-page payload.`
            : "";
        const hasUnavailableScripts = inertia.scriptUnreadableCount > 0 || rsc.scriptUnreadableCount > 0;
        const scriptCopy = hasUnavailableScripts
          ? ` Readable route JavaScript bytes: Inertia ${formatBytes(inertia.scriptBytes)} (${inertia.scriptReadableCount}/${inertia.scriptCount} scripts), RSC ${formatBytes(rsc.scriptBytes)} (${rsc.scriptReadableCount}/${rsc.scriptCount} scripts).`
          : scriptDelta >= 0
            ? ` RSC referenced ${formatBytes(scriptDelta)} less route JavaScript.`
            : ` Inertia referenced ${formatBytes(Math.abs(scriptDelta))} less route JavaScript.`;
        const completionCopy =
          completionDelta >= 0
            ? `${label}: RSC completed ${formatMs(completionDelta)} faster in this browser fetch.`
            : `${label}: Inertia completed ${formatMs(Math.abs(completionDelta))} faster in this browser fetch.`;
        const firstChunkCopy =
          firstChunkDelta >= 0
            ? ` RSC delivered first streamed bytes ${formatMs(firstChunkDelta)} sooner.`
            : ` Inertia delivered first bytes ${formatMs(Math.abs(firstChunkDelta))} sooner.`;
        const byteCopy =
          byteDelta >= 0
            ? ` RSC transferred ${formatBytes(byteDelta)} less HTML in this run.`
            : ` Inertia transferred ${formatBytes(Math.abs(byteDelta))} less HTML in this run.`;

        return `${completionCopy}${firstChunkCopy}${byteCopy}${scriptCopy}${payloadCopy}`;
      };

      const runRace = async (scope) => {
        const label = scope.getAttribute("data-route-pair-label") || "Route pair";
        const summary = scope.querySelector("[data-race-summary]");
        const routes = {
          inertia: scope.getAttribute("data-inertia-url"),
          rsc: scope.getAttribute("data-rsc-url"),
        };

        if (summary) summary.textContent = `${label}: loading both routes with cache-busting query strings.`;

        const [inertiaResult, rscResult] = await Promise.allSettled([
          measureRoute(scope, "inertia", routes.inertia),
          measureRoute(scope, "rsc", routes.rsc),
        ]);

        if (inertiaResult.status === "fulfilled" && rscResult.status === "fulfilled") {
          if (summary) summary.textContent = `${label}: HTML race complete. Measuring referenced route scripts now.`;
          const [inertia, rsc] = await Promise.all([
            measureRouteScripts(scope, "inertia", inertiaResult.value),
            measureRouteScripts(scope, "rsc", rscResult.value),
          ]);
          if (summary) summary.textContent = describeResults(label, inertia, rsc);
          return;
        }

        await Promise.all(
          [
            ["inertia", inertiaResult],
            ["rsc", rscResult],
          ]
            .filter(([, result]) => result.status === "fulfilled")
            .map(([variant, result]) => measureRouteScripts(scope, variant, result.value)),
        );

        for (const [variant, result] of [
          ["inertia", inertiaResult],
          ["rsc", rscResult],
        ]) {
          if (result.status === "rejected") {
            setCardState(scope, variant, "error");
            setMetric(scope, variant, "status", "Failed");
            setMetric(scope, variant, "serverTiming", result.reason?.message || "Request failed");
          }
        }
        if (summary) summary.textContent = `${label}: one route failed to load. Check the renderer and Rails logs, then rerun the race.`;
      };

      const runAll = async () => {
        runButtons.forEach((button) => button.setAttribute("disabled", "disabled"));
        if (runStatus) runStatus.textContent = "Running matched public route pairs...";

        for (const pairElement of pairElements) {
          await runRace(pairElement);
        }

        if (runStatus) runStatus.textContent = "All route pairs complete";
        runButtons.forEach((button) => button.removeAttribute("disabled"));
      };

      runButtons.forEach((button) => button.addEventListener("click", runAll));
      runAll();
    })();
  </script>
<% end %>

<% react_on_rails_url = PublicProductRscDemoPresenter::REACT_ON_RAILS_URL %>
<% react_on_rails_github_url = PublicProductRscDemoPresenter::REACT_ON_RAILS_GITHUB_URL %>
<% shakacode_url = PublicProductRscDemoPresenter::SHAKACODE_URL %>
<% consultation_url = PublicProductRscDemoPresenter::CONSULTATION_URL %>
<% gumroad_discover_reference_url = PublicProductRscDemoPresenter::GUMROAD_DISCOVER_REFERENCE_URL %>

<div class="dd dd-performance" data-rsc-performance-lab>
  <aside class="dd-side">
    <div class="dd-brand">
      <a href="<%= root_path %>">Gumroad</a>
      <p>React Server Components via React on Rails Pro lab</p>
    </div>

    <nav class="dd-nav" aria-label="Public performance lab routes">
      <a href="<%= root_path %>">Home</a>
      <a href="<%= public_product_performance_demo_path %>" aria-current="page">Performance lab</a>
      <a href="<%= public_product_inertia_demo_path %>">Product Inertia</a>
      <a href="<%= public_product_rsc_demo_path %>">Product RSC</a>
      <a href="<%= public_product_discover_inertia_demo_path %>">Discover Inertia</a>
      <a href="<%= public_product_discover_rsc_demo_path %>">Discover RSC</a>
      <a href="<%= react_on_rails_url %>" target="_blank" rel="noopener">React on Rails</a>
      <a href="<%= react_on_rails_github_url %>" target="_blank" rel="noopener">react_on_rails source</a>
      <a href="<%= shakacode_url %>" target="_blank" rel="noopener">ShakaCode</a>
    </nav>

    <footer class="dd-meta">
      <strong>Production-shaped public fixtures</strong>
      <p>For React on Rails evaluators, ShakaCode prospects, and Gumroad maintainers.</p>
      <p><a href="<%= consultation_url %>" target="_blank" rel="noopener">Book a ShakaCode consultation</a></p>
    </footer>
  </aside>

  <main class="dd-main">
    <header class="dd-header dd-hero-grid">
      <div>
        <p class="dd-eyebrow">Public buyer-page A/B report</p>
        <h1>Gumroad RSC performance lab</h1>
        <p>
          This lab compares matched Inertia and React Server Components via React on Rails Pro routes for the two public
          pages that matter most: a product detail page and a Discover marketplace page.
        </p>
        <p class="dd-proof-line">
          The runtime performance premise is React Server Components via React on Rails Pro, not Rspack.
          Rspack helps the build pipeline; RSC must earn adoption through public-page performance.
        </p>
      </div>

      <div class="dd-actions">
        <button type="button" class="dd-btn" data-rerun-race>Rerun both A/B races</button>
        <a href="<%= root_path %>" class="dd-btn">Back to home</a>
        <a href="<%= react_on_rails_url %>" target="_blank" rel="noopener" class="dd-btn">Learn React on Rails</a>
        <a href="<%= consultation_url %>" target="_blank" rel="noopener" class="dd-btn">Book a consultation</a>
      </div>
    </header>

    <div class="dd-body">
      <p class="dd-note">
        The committed fixtures are synthetic but production-shaped. A small public-page sampler confirmed that Gumroad
        Discover exposes a <code>Discover/Index</code> Inertia payload with a dense product grid and taxonomy data, while
        public product pages expose <code>Products/Discover/Show</code> product, seller, cover, rating, purchase, section,
        and taxonomy props. This repo uses that shape without copying creator content.
      </p>

      <% report = @hosted_benchmark_report %>
      <% provenance = report[:provenance] %>

      <section class="dd-section" id="hosted-headless-chrome-result">
        <header>
          <h2>Hosted headless Chrome A/B result</h2>
          <p>
            Captured <code><%= provenance[:captured_at_utc_date] %> UTC</code> against
            <code><%= provenance[:host] %></code> with <%= provenance[:browser_summary] %>,
            <%= provenance[:method_summary] %>.
          </p>
        </header>

        <p class="dd-note">
          <strong>How to read this:</strong> each row is the same measurement on two matched routes.
          <strong>A = Inertia</strong> (the current control); <strong>B = RSC</strong>
          (the React Server Components via React on Rails Pro candidate). Every metric is
          <strong>lower is better</strong>, so the winner is whichever column is lower by more than the
          <%= format("%g", PublicProductRscDemoPresenter::BENCHMARK_TIE_BAND_PERCENT) %>% noise band.
        </p>

        <% report[:surfaces].each do |surface| %>
          <article class="dd-ab-surface">
            <header>
              <h3><%= surface[:name] %></h3>
              <p>A <code><%= surface[:baseline_path] %></code> vs B <code><%= surface[:candidate_path] %></code></p>
            </header>

            <div class="dd-table">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Metric</th>
                    <th scope="col">A &middot; Inertia (control)</th>
                    <th scope="col">B &middot; RSC (candidate)</th>
                    <th scope="col">&Delta; (B vs A)</th>
                    <th scope="col">Winner</th>
                  </tr>
                </thead>
                <tbody>
                  <% surface[:rows].each do |row| %>
                    <tr>
                      <th scope="row"><%= row[:label] %></th>
                      <td><code><%= row[:inertia_display] %></code></td>
                      <td><code><%= row[:rsc_display] %></code></td>
                      <td><code><%= row[:delta_display] %></code></td>
                      <td><span class="dd-badge is-<%= row[:winner] %>"><%= row[:winner_label] %></span></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <p class="dd-source-links">
              <span class="dd-source-links-label">View this surface's source (tracks <code>main</code>):</span>
              <% surface[:source_links].each do |link| %>
                <a href="<%= link[:url] %>" target="_blank" rel="noopener"><%= link[:label] %></a>
              <% end %>
            </p>
          </article>
        <% end %>

        <div class="dd-list">
          <% report[:caveats].each do |caveat| %>
            <article class="dd-row">
              <p class="dd-copy"><%= caveat %></p>
            </article>
          <% end %>
        </div>

        <p class="dd-note is-info">
          The source links track <code>main</code>, so they show the current shape of the hosted app, while the
          numbers above were captured on <code><%= provenance[:captured_at_utc_date] %> UTC</code> and refresh
          whenever a new benchmark <code>summary.json</code> is committed.
        </p>
      </section>

      <section class="dd-section" id="where-inertia-wins">
        <header>
          <h2>Where Inertia still wins, and how RSC closes the gap</h2>
          <p>
            Honest reporting means naming the metrics RSC does not win yet. Each gap below has a concrete
            optimization and a tracked React on Rails issue.
          </p>
        </header>

        <div class="dd-list">
          <% report[:inertia_win_groups].each do |group| %>
            <article class="dd-row">
              <p class="dd-copy">
                <strong><%= group[:label] %></strong>
                (<%= group[:occurrences].map { |occurrence| "#{occurrence[:surface]} #{occurrence[:delta_display]}" }.join(", ") %>):
                <%= group[:cause] %>
              </p>
              <p class="dd-copy"><strong>How RSC wins it:</strong> <%= group[:lever] %></p>
              <p class="dd-copy">
                <strong>Tracked in:</strong>
                <% group[:issues].each_with_index do |issue, index| %><%= ", " if index.positive? %><a href="<%= issue[:url] %>" target="_blank" rel="noopener">react_on_rails#<%= issue[:number] %></a><% end %>
              </p>
            </article>
          <% end %>

          <article class="dd-row">
            <p class="dd-copy">
              <strong>Time to first meaningful HTML:</strong> finer Suspense boundaries would let the candidate
              stream above-the-fold content sooner without regressing final paint. Tracked in
              <a href="<%= PublicProductRscDemoPresenter::REACT_ON_RAILS_ISSUE_BASE %>/3886" target="_blank" rel="noopener">react_on_rails#3886</a>.
            </p>
          </article>
        </div>
      </section>

      <section class="dd-section">
        <header>
          <h2>What this report is allowed to claim</h2>
          <p>
            The hosted headless Chrome A/B run shows a meaningful browser-navigation win on the right public surfaces.
            A Gumroad adoption proposal still needs a mobile Lighthouse/ShakaPerf repeat with TBT, INP, and mobile score.
          </p>
        </header>

        <div class="dd-list">
          <article class="dd-row">
            <p class="dd-copy">
              <strong>For Gumroad maintainers:</strong> judge public product and Discover pages first because they are
              SEO-sensitive, conversion-sensitive, logged out, and mobile-heavy.
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>For React on Rails evaluators:</strong> inspect how Rails can stream React Server Components while
              keeping interactive work isolated instead of making the whole public page client-rendered.
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>For ShakaCode prospects:</strong> use this as a concrete performance consulting artifact, then
              <a href="<%= consultation_url %>" target="_blank" rel="noopener">book a consultation</a> if your Rails app has similar public-page constraints.
            </p>
          </article>
        </div>
      </section>

      <div class="dd-race-toolbar">
        <button type="button" class="dd-btn" data-rerun-race>Rerun both A/B races</button>
        <span class="dd-stamp" data-run-status>Waiting to start</span>
      </div>

      <%= render "public_product_rsc_demo/route_pair_lab",
        label: "Product detail",
        summary: "Buyer-facing product storytelling, price, reviews, seller context, purchase framing, FAQ, and recommendations.",
        inertia_path: public_product_inertia_demo_path,
        rsc_path: public_product_rsc_demo_path,
        inertia_label: "Product Inertia route",
        rsc_label: "Product RSC route" %>

      <%= render "public_product_rsc_demo/route_pair_lab",
        label: "Discover marketplace",
        summary: "Dense browse grid, taxonomy/category context, filters, editorial collections, prices, ratings, and seller cards.",
        inertia_path: public_product_discover_inertia_demo_path,
        rsc_path: public_product_discover_rsc_demo_path,
        inertia_label: "Discover Inertia route",
        rsc_label: "Discover RSC route" %>

      <section class="dd-section">
        <header>
          <h2>Reproduce with ShakaPerf</h2>
          <p>
            Use alternating cycles so route order is balanced. The public Gumroad pages are useful external references,
            but the defensible before/after comparison is same data, same host, matched Inertia versus RSC routes.
          </p>
        </header>

        <div class="dd-list">
          <article class="dd-row">
            <p class="dd-copy">
              <strong>Product detail pair:</strong>
              <code>ruby scripts/perf/compare_dashboard_routes.rb --public --base-url https://gumroad.reactonrails.com --measure-base-url https://gumroad.reactonrails.com --path /public_product/inertia_demo --path /public_product/rsc_demo --label hosted-public-product-alternating-8 --cycles 8 --server-warmup-requests 2 --require-driver-match --timeout 90</code>
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>Discover pair:</strong>
              <code>ruby scripts/perf/compare_dashboard_routes.rb --public --base-url https://gumroad.reactonrails.com --measure-base-url https://gumroad.reactonrails.com --path /public_product/discover_inertia_demo --path /public_product/discover_rsc_demo --label hosted-public-discover-alternating-8 --cycles 8 --server-warmup-requests 2 --require-driver-match --timeout 90</code>
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>External shape reference:</strong>
              <a href="<%= gumroad_discover_reference_url %>" target="_blank" rel="noopener"><%= gumroad_discover_reference_url %></a>
              helps explain why these fixtures are shaped this way, but it should not be treated as the A/B baseline.
            </p>
          </article>
          <article class="dd-row" id="fixture-provenance">
            <p class="dd-copy">
              <strong>Fixture provenance:</strong>
              public page shape sampling observed <code>Discover/Index</code> with a 36-card product grid,
              8 tag buckets, 8 filetype buckets, and taxonomy navigation, plus
              <code>Products/Discover/Show</code> with product seller, cover, rating, price, purchase, description,
              and taxonomy fields. The committed benchmark fixture keeps those field families but uses synthetic names,
              copy, prices, and cover placeholders instead of creator content, product URLs, seller URLs, or image URLs.
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>Hosted result docs:</strong>
              the commands above reproduce the hosted public buyer-page run, while the headline table includes the
              supporting caveat: this is a headless Chrome navigation result, not the final mobile Lighthouse claim.
            </p>
          </article>
        </div>
      </section>
    </div>
  </main>
</div>
