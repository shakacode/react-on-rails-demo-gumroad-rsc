<% content_for :script do %>
  <script nonce="<%= content_security_policy_nonce %>">
    (() => {
      const root = document.querySelector("[data-rsc-performance-lab]");
      if (!root) return;

      const pairElements = Array.from(root.querySelectorAll("[data-route-pair]"));
      const runButtons = Array.from(root.querySelectorAll("[data-rerun-race]"));
      const runStatus = root.querySelector("[data-run-status]");

      const numberFormatter = new Intl.NumberFormat(undefined, { maximumFractionDigits: 0 });

      const formatMs = (value) => {
        if (!Number.isFinite(value)) return "n/a";
        return `${numberFormatter.format(value)} ms`;
      };

      const formatBytes = (value) => {
        if (!Number.isFinite(value)) return "n/a";
        if (value >= 1024 * 1024) return `${(value / 1024 / 1024).toFixed(2)} MB`;
        if (value >= 1024) return `${(value / 1024).toFixed(1)} KB`;
        return `${numberFormatter.format(value)} B`;
      };

      const formatHtmlSize = (result) => {
        if (Number.isFinite(result.wireBytes) && result.wireBytes > 0) {
          return `${formatBytes(result.wireBytes)} wire / ${formatBytes(result.decodedBytes)} decoded`;
        }
        return `${formatBytes(result.decodedBytes)} decoded`;
      };

      const setText = (scope, selector, value) => {
        const element = scope.querySelector(selector);
        if (element) element.textContent = value;
      };

      const setMetric = (scope, variant, metric, value) => {
        setText(scope, `[data-metric="${variant}.${metric}"]`, value);
      };

      const setCardState = (scope, variant, state) => {
        const card = scope.querySelector(`[data-route-card="${variant}"]`);
        if (card) card.setAttribute("data-state", state);
      };

      const urlWithCacheBust = (path) => {
        const url = new URL(path, window.location.href);
        url.searchParams.set("perf_lab_run", `${Date.now()}-${Math.random().toString(16).slice(2)}`);
        return url.toString();
      };

      const htmlDecode = (value) => {
        const textarea = document.createElement("textarea");
        textarea.innerHTML = value;
        return textarea.value;
      };

      const encodedByteLength = (value) => new TextEncoder().encode(value).byteLength;

      const inertiaPayloadBytes = (html) => {
        const match = html.match(/data-page="([^"]*)"/);
        if (!match) return 0;
        return encodedByteLength(htmlDecode(match[1]));
      };

      const routeScriptSources = (html) => {
        const documentFragment = new DOMParser().parseFromString(html, "text/html");
        return Array.from(documentFragment.querySelectorAll("script[src]"), (script) =>
          new URL(script.getAttribute("src"), window.location.href).toString(),
        );
      };

      const routeScriptBytes = async (sources) => {
        const results = await Promise.all(
          sources.map(async (source) => {
            try {
              const sourceUrl = new URL(source, window.location.href);
              const response = await fetch(sourceUrl.toString(), { cache: "force-cache", credentials: "omit" });
              if (!response.ok) return { bytes: 0, readable: false };

              return { bytes: (await response.arrayBuffer()).byteLength, readable: true };
            } catch {
              return { bytes: 0, readable: false };
            }
          }),
        );

        return {
          bytes: results.reduce((total, result) => total + result.bytes, 0),
          readableCount: results.filter((result) => result.readable).length,
          unreadableCount: results.filter((result) => !result.readable).length,
        };
      };

      const formatScriptMetric = ({ bytes, readableCount, unreadableCount }, totalCount) => {
        const readableCopy = `${formatBytes(bytes)} across ${readableCount}/${totalCount} readable scripts`;
        return unreadableCount > 0 ? `${readableCopy}; ${unreadableCount} unavailable` : readableCopy;
      };

      const streamTimingSummary = (serverTiming) => {
        if (!serverTiming || serverTiming === "No Server-Timing header exposed") return "No stream timing attribution";

        const hasShell = serverTiming.includes("ror_stream_shell");
        const hasRendererPrepare = serverTiming.includes("ror_renderer_prepare");
        if (hasShell && hasRendererPrepare) return "Rails shell + Node renderer prepare timing exposed";
        if (hasShell) return "Rails streamed shell timing exposed";
        if (hasRendererPrepare) return "Node renderer prepare timing exposed";
        if (serverTiming.includes("action_total")) return "Rails action timing only";
        return "No Pro stream timing attribution";
      };

      const resetMetrics = (scope, variant) => {
        setCardState(scope, variant, "loading");
        setMetric(scope, variant, "status", "Loading...");
        setMetric(scope, variant, "firstChunk", "...");
        setMetric(scope, variant, "complete", "...");
        setMetric(scope, variant, "bytes", "...");
        setMetric(scope, variant, "scripts", "...");
        setMetric(scope, variant, "payload", "...");
        setMetric(scope, variant, "streamTiming", "Waiting for headers");
        setMetric(scope, variant, "serverTiming", "Waiting for headers");
      };

      const measureRoute = async (scope, variant, path) => {
        resetMetrics(scope, variant);

        const startedAt = performance.now();
        const requestUrl = urlWithCacheBust(path);
        const response = await fetch(requestUrl, {
          cache: "no-store",
          credentials: "omit",
          headers: {
            Accept: "text/html",
            "X-Gumroad-Rsc-Performance-Lab": "1",
          },
        });
        const headersAt = performance.now();
        const serverTiming = response.headers.get("Server-Timing") || "No Server-Timing header exposed";

        if (!response.ok) {
          throw new Error(`${response.status} ${response.statusText || "response error"}`);
        }

        let firstChunkAt = null;
        let bytes = 0;
        let html = "";

        if (response.body?.getReader) {
          const reader = response.body.getReader();
          const decoder = new TextDecoder();

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            if (firstChunkAt == null) firstChunkAt = performance.now();
            bytes += value.byteLength;
            html += decoder.decode(value, { stream: true });
            setMetric(scope, variant, "bytes", formatBytes(bytes));
          }

          html += decoder.decode();
        } else {
          html = await response.text();
          bytes = encodedByteLength(html);
          firstChunkAt = headersAt;
        }

        const completedAt = performance.now();
        const payloadBytes = inertiaPayloadBytes(html);
        const scriptSources = routeScriptSources(html);
        const timingEntries = performance.getEntriesByName(requestUrl);
        const timingEntry = timingEntries[timingEntries.length - 1];
        const wireBytes = timingEntry && timingEntry.encodedBodySize ? timingEntry.encodedBodySize : null;
        const result = {
          decodedBytes: bytes,
          wireBytes,
          firstChunkMs: (firstChunkAt || headersAt) - startedAt,
          headersMs: headersAt - startedAt,
          inertiaPayloadBytes: payloadBytes,
          scriptBytes: 0,
          scriptCount: scriptSources.length,
          scriptReadableCount: 0,
          scriptSources,
          scriptUnreadableCount: scriptSources.length,
          serverTiming,
          totalMs: completedAt - startedAt,
        };

        setMetric(scope, variant, "status", "HTML complete");
        setMetric(scope, variant, "firstChunk", formatMs(result.firstChunkMs));
        setMetric(scope, variant, "complete", formatMs(result.totalMs));
        setMetric(scope, variant, "bytes", formatHtmlSize(result));
        setMetric(scope, variant, "scripts", "Waiting for route script pass");
        setMetric(scope, variant, "payload", payloadBytes > 0 ? formatBytes(payloadBytes) : "None");
        setMetric(scope, variant, "streamTiming", streamTimingSummary(serverTiming));
        setMetric(scope, variant, "serverTiming", serverTiming);

        return result;
      };

      const measureRouteScripts = async (scope, variant, result) => {
        setMetric(scope, variant, "status", "Measuring scripts...");
        const scriptMetric = await routeScriptBytes(result.scriptSources);
        result.scriptBytes = scriptMetric.bytes;
        result.scriptReadableCount = scriptMetric.readableCount;
        result.scriptUnreadableCount = scriptMetric.unreadableCount;
        setMetric(scope, variant, "scripts", formatScriptMetric(scriptMetric, result.scriptCount));
        setMetric(scope, variant, "status", "Complete");
        setCardState(scope, variant, "complete");
        return result;
      };

      const describeResults = (label, inertia, rsc) => {
        const wireKnown = Number.isFinite(inertia.wireBytes) && Number.isFinite(rsc.wireBytes);
        const inertiaHtml = wireKnown ? inertia.wireBytes : inertia.decodedBytes;
        const rscHtml = wireKnown ? rsc.wireBytes : rsc.decodedBytes;
        const htmlBasis = wireKnown ? "over the wire" : "in this fetch";
        const htmlDelta = inertiaHtml - rscHtml;
        const firstChunkDelta = inertia.firstChunkMs - rsc.firstChunkMs;
        const scriptDelta = inertia.scriptBytes - rsc.scriptBytes;

        const firstChunkCopy =
          firstChunkDelta >= 0
            ? `RSC delivered first streamed bytes ${formatMs(firstChunkDelta)} sooner.`
            : `Inertia delivered first bytes ${formatMs(Math.abs(firstChunkDelta))} sooner.`;
        const htmlCopy =
          htmlDelta >= 0
            ? ` RSC sent ${formatBytes(htmlDelta)} less HTML ${htmlBasis}.`
            : ` RSC sent ${formatBytes(Math.abs(htmlDelta))} more HTML ${htmlBasis} — more server-rendered content, Brotli-compressed in transit.`;
        const unreadableScripts = inertia.scriptUnreadableCount + rsc.scriptUnreadableCount;
        const scriptCaveat =
          unreadableScripts > 0
            ? ` (measured from readable scripts only: Inertia ${inertia.scriptReadableCount}/${inertia.scriptCount}, RSC ${rsc.scriptReadableCount}/${rsc.scriptCount})`
            : "";
        const scriptCopy =
          scriptDelta >= 0
            ? ` It referenced ${formatBytes(scriptDelta)} less route JavaScript across ${rsc.scriptCount} request(s) vs ${inertia.scriptCount}.${scriptCaveat}`
            : ` Inertia referenced ${formatBytes(Math.abs(scriptDelta))} less route JavaScript.${scriptCaveat}`;
        const payloadCopy =
          inertia.inertiaPayloadBytes > 0
            ? ` The Inertia document also carried ${formatBytes(inertia.inertiaPayloadBytes)} of serialized page props; the RSC document carried none.`
            : "";
        const completionCopy = ` Raw full-body download (Inertia ${formatMs(inertia.totalMs)}, RSC ${formatMs(rsc.totalMs)}) is not the verdict: it favors the smaller document and ignores the JavaScript execution and hydration the browser still does. The controlled comparison is the ShakaPerf navigation result above.`;

        return `${label}: ${firstChunkCopy}${htmlCopy}${scriptCopy}${payloadCopy}${completionCopy}`;
      };

      const runRace = async (scope) => {
        const label = scope.getAttribute("data-route-pair-label") || "Route pair";
        const summary = scope.querySelector("[data-race-summary]");
        const routes = {
          inertia: scope.getAttribute("data-inertia-url"),
          rsc: scope.getAttribute("data-rsc-url"),
        };

        if (summary) summary.textContent = `${label}: loading both routes with cache-busting query strings.`;

        const [inertiaResult, rscResult] = await Promise.allSettled([
          measureRoute(scope, "inertia", routes.inertia),
          measureRoute(scope, "rsc", routes.rsc),
        ]);

        if (inertiaResult.status === "fulfilled" && rscResult.status === "fulfilled") {
          if (summary) summary.textContent = `${label}: HTML race complete. Measuring referenced route scripts now.`;
          const [inertia, rsc] = await Promise.all([
            measureRouteScripts(scope, "inertia", inertiaResult.value),
            measureRouteScripts(scope, "rsc", rscResult.value),
          ]);
          if (summary) summary.textContent = describeResults(label, inertia, rsc);
          return;
        }

        await Promise.all(
          [
            ["inertia", inertiaResult],
            ["rsc", rscResult],
          ]
            .filter(([, result]) => result.status === "fulfilled")
            .map(([variant, result]) => measureRouteScripts(scope, variant, result.value)),
        );

        for (const [variant, result] of [
          ["inertia", inertiaResult],
          ["rsc", rscResult],
        ]) {
          if (result.status === "rejected") {
            setCardState(scope, variant, "error");
            setMetric(scope, variant, "status", "Failed");
            setMetric(scope, variant, "serverTiming", result.reason?.message || "Request failed");
          }
        }
        if (summary) summary.textContent = `${label}: one route failed to load. Check the renderer and Rails logs, then rerun the race.`;
      };

      const runAll = async () => {
        if (typeof performance.clearResourceTimings === "function") performance.clearResourceTimings();
        runButtons.forEach((button) => button.setAttribute("disabled", "disabled"));
        if (runStatus) runStatus.textContent = "Running matched public route pairs...";

        for (const pairElement of pairElements) {
          await runRace(pairElement);
        }

        if (runStatus) runStatus.textContent = "All route pairs complete";
        runButtons.forEach((button) => button.removeAttribute("disabled"));
      };

      runButtons.forEach((button) => button.addEventListener("click", runAll));
      runAll();
    })();
  </script>
<% end %>

<% react_on_rails_url = PublicProductRscDemoPresenter::REACT_ON_RAILS_URL %>
<% react_on_rails_github_url = PublicProductRscDemoPresenter::REACT_ON_RAILS_GITHUB_URL %>
<% shakacode_url = PublicProductRscDemoPresenter::SHAKACODE_URL %>
<% consultation_url = PublicProductRscDemoPresenter::CONSULTATION_URL %>
<% gumroad_product_reference_url = PublicProductRscDemoPresenter::GUMROAD_PRODUCT_REFERENCE_URL %>
<% gumroad_discover_reference_url = PublicProductRscDemoPresenter::GUMROAD_DISCOVER_REFERENCE_URL %>
<% public_home_path = about_path %>
<% deployed_performance_url = @presenter.deployed_performance_demo_url %>

<div class="dd dd-performance" data-rsc-performance-lab>
  <aside class="dd-side">
    <div class="dd-brand">
      <a href="<%= public_home_path %>">Gumroad</a>
      <p>React Server Components via React on Rails Pro lab</p>
    </div>

    <nav class="dd-nav" aria-label="Public performance lab routes">
      <a href="<%= public_home_path %>">Home</a>
      <a href="<%= public_product_performance_demo_path %>" aria-current="page">Performance lab</a>
      <a href="<%= deployed_performance_url %>" target="_blank" rel="noopener">Deployed demo</a>
      <a href="<%= public_product_inertia_demo_path %>">Product Inertia</a>
      <a href="<%= public_product_rsc_demo_path %>">Product RSC</a>
      <a href="<%= public_product_discover_inertia_demo_path %>">Discover Inertia</a>
      <a href="<%= public_product_discover_rsc_demo_path %>">Discover RSC</a>
      <a href="<%= react_on_rails_url %>" target="_blank" rel="noopener">React on Rails</a>
      <a href="<%= react_on_rails_github_url %>" target="_blank" rel="noopener">react_on_rails source</a>
      <a href="<%= shakacode_url %>" target="_blank" rel="noopener">ShakaCode</a>
    </nav>

    <footer class="dd-meta">
      <strong>Production-shaped public fixtures</strong>
      <p>For React on Rails evaluators, ShakaCode prospects, and Gumroad maintainers.</p>
      <p><a href="<%= consultation_url %>" target="_blank" rel="noopener">Book a ShakaCode consultation</a></p>
    </footer>
  </aside>

  <main class="dd-main">
    <header class="dd-header dd-hero-grid">
      <div>
        <p class="dd-eyebrow">Public buyer-page A/B report</p>
        <h1>Gumroad RSC performance lab</h1>
        <p>
          This lab compares matched Inertia and React Server Components via React on Rails Pro routes for the two public
          pages that matter most: a product detail page and a Discover marketplace page.
        </p>
        <p class="dd-proof-line">
          The runtime performance premise is React Server Components via React on Rails Pro, not Rspack.
          Rspack helps the build pipeline; RSC must earn adoption through public-page performance.
        </p>
      </div>

      <div class="dd-actions">
        <button type="button" class="dd-btn" data-rerun-race>Rerun both A/B races</button>
        <a href="<%= public_home_path %>" class="dd-btn">Back to home</a>
        <a href="<%= deployed_performance_url %>" target="_blank" rel="noopener" class="dd-btn">Compare deployed demo</a>
        <a href="<%= react_on_rails_url %>" target="_blank" rel="noopener" class="dd-btn">Learn React on Rails</a>
        <a href="<%= consultation_url %>" target="_blank" rel="noopener" class="dd-btn">Book a consultation</a>
      </div>
    </header>

    <div class="dd-body">
      <p class="dd-note">
        The product fixture is source-attributed to
        <a href="<%= gumroad_product_reference_url %>" target="_blank" rel="noopener">Tendon Book by Jacked Athlete</a>:
        title, seller, price, ebook type, rating summary, and source link are preserved, while longer descriptive copy is
        rewritten for this demo. A small public-page sampler also confirmed that Gumroad Discover exposes a
        <code>Discover/Index</code> Inertia payload with a dense product grid and taxonomy data, while public product pages
        expose <code>Products/Discover/Show</code> product, seller, cover, rating, purchase, section, and taxonomy props.
      </p>

      <% stack_versions = @presenter.react_stack_versions %>
      <section class="dd-section" id="react-on-rails-pro-17-audit">
        <header>
          <h2>React on Rails Pro 17 / React 19.2 audit</h2>
          <p>
            This pass checked the demo against the current Pro 17 RC line and the public Gumroad upstream delta on
            July 8, 2026.
          </p>
        </header>

        <div class="dd-list">
          <article class="dd-row">
            <p class="dd-copy">
              <strong>Runtime stack:</strong>
              React <code><%= stack_versions[:react] || "unknown" %></code>,
              React DOM <code><%= stack_versions[:react_dom] || "unknown" %></code>,
              React on Rails Pro gem <code><%= stack_versions[:react_on_rails_pro_gem] || "unknown" %></code>,
              React on Rails Pro npm <code><%= stack_versions[:react_on_rails_pro_npm] || "unknown" %></code>,
              and <code>react-on-rails-rsc</code> <code><%= stack_versions[:react_on_rails_rsc] || "unknown" %></code>.
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>Streaming now active:</strong>
              the public RSC routes opt into Pro stream observability, so the live race can expose
              <code>ror_stream_shell</code> and <code>ror_renderer_prepare</code> timing when the renderer returns them.
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>Static caching boundary:</strong>
              Pro 17 adds buffered/static RSC helpers for cacheable public shells, but this headline route pair stays
              matched and uncached. A cached static RSC variant should be measured as a separate claim.
            </p>
          </article>
          <article class="dd-row">
            <p class="dd-copy">
              <strong>Latest Gumroad shape check:</strong>
              upstream now includes buyer-local currency, richer public product/profile JSON, custom HTML product pages,
              and Discover category fixes. Those are useful adoption context, but a broad upstream merge would pull in
              the unrelated Vite migration and is not part of this focused demo pass.
            </p>
          </article>
        </div>
      </section>

      <% verdict_labels = {
        rsc_wins: ["React on Rails Pro RSC wins", "dd-verdict--win"],
        inertia_wins: ["Inertia wins", "dd-verdict--loss"],
        tie: ["About the same", "dd-verdict--tie"],
      } %>

      <section class="dd-section" id="current-shakaperf-result">
        <header>
          <h2>Current branch ShakaPerf A/B result</h2>
          <p><%= @presenter.local_benchmark_method_note %></p>
          <p class="dd-source-links dd-source-links--lead">
            <span>Source for the measured app:</span>
            <a href="<%= @presenter.local_benchmark_artifact_url %>" target="_blank" rel="noopener">current branch A/B summary</a>
            <a href="<%= @presenter.hosted_review_benchmark_artifact_url %>" target="_blank" rel="noopener">hosted review-app A/B summary</a>
            <a href="<%= @presenter.lighthouse_comparator_artifact_url %>" target="_blank" rel="noopener">Lighthouse URL-pair summary</a>
            <a href="<%= deployed_performance_url %>" target="_blank" rel="noopener">deployed performance lab</a>
            <a href="<%= @presenter.hosted_benchmark_artifact_url %>" target="_blank" rel="noopener">historical hosted A/B summary</a>
            <a href="<%= "#{PublicProductRscDemoPresenter::REPO_SOURCE_BASE_URL}/#{PublicProductRscDemoPresenter::CONTROLLER_SOURCE_PATH}" %>" target="_blank" rel="noopener">controller</a>
            <a href="<%= "#{PublicProductRscDemoPresenter::REPO_SOURCE_BASE_URL}/#{PublicProductRscDemoPresenter::PRESENTER_SOURCE_PATH}" %>" target="_blank" rel="noopener">fixtures</a>
          </p>
        </header>

        <p class="dd-note is-info">
          <strong>How to read this:</strong> the control (column A) is Gumroad's current <strong>Inertia</strong> route; the
          candidate (column B) is the <strong>React on Rails Pro RSC</strong> route. Same fixture data, same host, same harness.
          Every metric is lower-is-better. The verdict only names a winner when the gap exceeds
          &plusmn;<%= PublicProductRscDemoPresenter::BENCHMARK_TIE_BAND_PERCENT %>%; closer than that reads &ldquo;about the same.&rdquo;
        </p>

        <% @presenter.local_benchmark_surfaces.each do |surface| %>
          <% sources = @presenter.route_source_links(surface[:page_kind]) %>
          <div class="dd-surface-block">
            <header class="dd-surface-head">
              <h3><%= surface[:surface] %></h3>
              <p class="dd-source-links">
                <span>A &middot; Inertia route source:</span>
                <% sources[:inertia].each do |link| %><a href="<%= link[:url] %>" target="_blank" rel="noopener"><%= link[:label] %></a><% end %>
              </p>
              <p class="dd-source-links">
                <span>B &middot; React on Rails Pro RSC route source:</span>
                <% sources[:rsc].each do |link| %><a href="<%= link[:url] %>" target="_blank" rel="noopener"><%= link[:label] %></a><% end %>
              </p>
            </header>

            <div class="dd-table">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Metric (lower is better)</th>
                    <th scope="col">A &middot; Inertia control</th>
                    <th scope="col">B &middot; React on Rails Pro RSC</th>
                    <th scope="col">Change (B vs A)</th>
                    <th scope="col">Verdict</th>
                  </tr>
                </thead>
                <tbody>
                  <% surface[:rows].each do |row| %>
                    <% label, klass = verdict_labels.fetch(row[:verdict]) %>
                    <tr>
                      <th scope="row"><%= row[:label] %></th>
                      <td><code><%= row[:inertia] %></code></td>
                      <td><code><%= row[:rsc] %></code></td>
                      <td><code><%= row[:delta] %></code></td>
                      <td><span class="dd-verdict <%= klass %>"><%= label %></span></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>

        <div class="dd-note is-info">
          <strong>What this shows:</strong> on the current Tendon Book fixture, RSC wins median navigation, response-end,
          and LCP on both same-host route pairs. The tradeoff is larger streamed HTML because the server-rendered content
          is present in the document; the hosted review-app and Lighthouse reruns below add public-network JavaScript,
          LCP, and mobile-score context.
          <% if @presenter.local_benchmark_caveats.any? %>
            <br />
            <strong>Caveats from the run:</strong>
          <% end %>
        </div>

        <% if @presenter.local_benchmark_caveats.any? %>
          <ul class="dd-caveats">
            <% @presenter.local_benchmark_caveats.each do |caveat| %>
              <li><%= caveat %></li>
            <% end %>
          </ul>
        <% end %>

        <p class="dd-note">
          <strong>Hosted review-app rerun:</strong>
          the PR 63 review app confirms the same direction on both public route pairs. Product detail median navigation
          moved from 602.75ms to 502.20ms, LCP from 500ms to 394ms, and route JavaScript requests from 7 to 1.
          Discover median navigation moved from 605.30ms to 529.25ms, LCP from 508ms to 430ms, and route JavaScript
          requests from 7 to 1. It also makes the server tradeoff clearer: streamed RSC response-end and HTML transfer
          are higher on the review app, so the honest claim is faster browser completion and less client JavaScript, not
          lower server TTLB everywhere.
          <br />
          <strong>Historical hosted run:</strong>
          the June 24, 2026 hosted headless-Chrome artifact is still linked above because it includes public-host JavaScript
          transfer and request-count evidence. It predates the Tendon Book fixture, so it is supporting context rather than
          the headline current result.
        </p>
      </section>

      <section class="dd-section" id="pagespeed-comparator-pairs">
        <header>
          <h2>PageSpeed comparator pairs</h2>
          <p>
            Point PageSpeed at these public URL pairs to compare this React on Rails RSC build with the live Gumroad
            status quo. On a review app, the demo links target the review app; the deployed-demo links target the current
            production demo at <%= PublicProductRscDemoPresenter::HOSTED_DEMO_BASE_URL %>. Use mobile as the headline result
            and desktop as a sanity check; the matched Inertia-vs-RSC route-pair data above remains the controlled A/B proof.
            A local Lighthouse matrix is linked above because the PageSpeed Insights API returned HTTP 429 from this
            environment. That fallback found the product mobile score moving from 0.56 to 0.99 with LCP moving from 14.7s to
            2.1s, and Discover mobile moving from 0.58 to 0.96 with LCP moving from 12.0s to 2.6s.
          </p>
        </header>

        <div class="dd-list">
          <% @presenter.page_speed_comparator_pairs.each do |pair| %>
            <article class="dd-row">
              <p class="dd-copy">
                <strong><%= pair[:surface] %>:</strong>
