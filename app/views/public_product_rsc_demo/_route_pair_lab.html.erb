<section
  class="dd-section"
  data-route-pair="<%= label.parameterize %>"
  data-route-pair-label="<%= label %>"
  data-inertia-url="<%= inertia_path %>"
  data-rsc-url="<%= rsc_path %>"
>
  <header>
    <h2><%= label %> A/B route pair</h2>
    <p><%= summary %></p>
  </header>

  <div class="dd-actions">
    <a href="<%= inertia_path %>" class="dd-btn"><%= inertia_label %></a>
    <a href="<%= rsc_path %>" class="dd-btn"><%= rsc_label %></a>
  </div>

  <div class="dd-lab-grid">
    <article class="dd-race-card" data-route-card="inertia" data-state="idle">
      <header>
        <p class="dd-eyebrow">Control</p>
        <h3><%= inertia_label %></h3>
        <span data-metric="inertia.status">Waiting</span>
      </header>
      <dl>
        <div>
          <dt>First streamed bytes</dt>
          <dd data-metric="inertia.firstChunk">...</dd>
        </div>
        <div>
          <dt>Complete response</dt>
          <dd data-metric="inertia.complete">...</dd>
        </div>
        <div>
          <dt>HTML response size</dt>
          <dd data-metric="inertia.bytes">...</dd>
        </div>
        <div>
          <dt>Route script bytes</dt>
          <dd data-metric="inertia.scripts">...</dd>
        </div>
        <div>
          <dt>Serialized Inertia payload</dt>
          <dd data-metric="inertia.payload">...</dd>
        </div>
      </dl>
      <p class="dd-server-timing" data-metric="inertia.serverTiming">Waiting for Server-Timing</p>
    </article>

    <article class="dd-race-card" data-route-card="rsc" data-state="idle">
      <header>
        <p class="dd-eyebrow">Candidate</p>
        <h3><%= rsc_label %></h3>
        <span data-metric="rsc.status">Waiting</span>
      </header>
      <dl>
        <div>
          <dt>First streamed bytes</dt>
          <dd data-metric="rsc.firstChunk">...</dd>
        </div>
        <div>
          <dt>Complete response</dt>
          <dd data-metric="rsc.complete">...</dd>
        </div>
        <div>
          <dt>HTML response size</dt>
          <dd data-metric="rsc.bytes">...</dd>
        </div>
        <div>
          <dt>Route script bytes</dt>
          <dd data-metric="rsc.scripts">...</dd>
        </div>
        <div>
          <dt>Serialized Inertia payload</dt>
          <dd data-metric="rsc.payload">...</dd>
        </div>
      </dl>
      <p class="dd-server-timing" data-metric="rsc.serverTiming">Waiting for Server-Timing</p>
    </article>
  </div>

  <p class="dd-note is-info" data-race-summary>
    The live race will summarize this route pair here.
  </p>
</section>
