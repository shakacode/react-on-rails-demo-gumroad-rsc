#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
control_sha=e720df1b4f13781af1b1b14efd10fe8a31e76641
experiment_sha=0c16a6cd36a2e2c89a7090e21c838a013b4d2654
control_dir=${SHAKAPERF_CONTROL_DIR:-"$repo_root/.shakaperf-historical-control"}
experiment_dir=${SHAKAPERF_EXPERIMENT_DIR:-"$repo_root/.shakaperf-historical-experiment"}

prepare_checkout() {
  label=$1
  directory=$2
  revision=$3

  expected_revision=$(git -C "$repo_root" rev-parse "$revision^{commit}")
  if [ -e "$directory/.git" ]; then
    actual_revision=$(git -C "$directory" rev-parse HEAD)
    if [ "$actual_revision" != "$expected_revision" ]; then
      echo "Historical $label checkout is $actual_revision; expected $expected_revision" >&2
      exit 1
    fi
    echo "Historical $label checkout already pinned to $actual_revision at $directory"
    return
  fi

  if [ -e "$directory" ]; then
    echo "Refusing to overwrite existing non-worktree path: $directory" >&2
    exit 1
  fi

  git -C "$repo_root" worktree add --detach "$directory" "$expected_revision"
  echo "Prepared historical $label $expected_revision at $directory"
}

prepare_checkout control "$control_dir" "$control_sha"
prepare_checkout experiment "$experiment_dir" "$experiment_sha"
